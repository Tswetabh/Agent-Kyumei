# Kyūmei Configuration
# Ollama endpoint (running locally on Windows)
OLLAMA_HOST=http://localhost:11434

# Open-weight model tag (must be available in 'ollama list')
KYUMEI_MODEL=gemma4:e2b

# Pipeline mode: 'single' (one structured prompt) or 'staged' (chained micro-prompts)
KYUMEI_PIPELINE_MODE=single

# Model sampling parameters
KYUMEI_TEMPERATURE=0.2

# Server host & port
KYUMEI_HOST=127.0.0.1
KYUMEI_PORT=8000
